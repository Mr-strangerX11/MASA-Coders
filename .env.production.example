# ═══════════════════════════════════════════════════════════════════════════════
# MASA-Coders Production Environment - cPanel Hosting
# ═══════════════════════════════════════════════════════════════════════════════
#
# IMPORTANT:
# 1. Copy this file to .env.production or update .env.local
# 2. Replace all values with your actual production credentials
# 3. Set file permissions to 600 in cPanel File Manager
# 4. Add these variables in cPanel Node.js Manager → Environment Variables
#
# ═══════════════════════════════════════════════════════════════════════════════

# MongoDB Connection (use MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/masacoders_prod

# JWT Secret (generate a strong random string - min 32 characters)
JWT_SECRET=generate-a-very-strong-random-secret-key-min-32-chars

# Admin credentials (used for initial setup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=GenerateStrongPassword123!

# App URLs (replace with your domain)
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Email Configuration (SMTP)
EMAIL_SERVICE=
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=noreply@yourdomain.com
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASSWORD=your-smtp-password

# Cloudinary (optional - for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Database: PostgreSQL (for conversations, messages, leads, analytics) ─────

# Create in cPanel Databases section
POSTGRES_URL=postgresql://username:password@localhost:5432/masacoders_prod

# ─── Redis (for BullMQ job queues and real-time pub/sub) ──────────────────

# Ask your hosting provider for Redis connection details
REDIS_URL=redis://localhost:6379

# ─── AI Provider (pick ONE) ──────────────────────────────────────────────────

# Option 1: OpenAI (requires paid account)
OPENAI_API_KEY=sk-your-actual-openai-api-key

# Option 2: Groq (free tier available)
# GROQ_API_KEY=gsk-your-actual-groq-api-key

# Model to use
AI_MODEL=gpt-4o-mini

# ─── WhatsApp Cloud API ──────────────────────────────────────────────────────

# Get from Meta Developer Console → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890

# ─── Meta Webhooks (WhatsApp + Messenger + Instagram) ──────────────────────

# Random verify token for webhooks
META_WEBHOOK_VERIFY_TOKEN=your_random_verify_token_32_chars_min

# App Secret from Meta Developer Console → App Settings → Basic
META_WEBHOOK_SECRET=your_meta_app_secret

# ─── Messenger / Instagram ──────────────────────────────────────────────────

# Page Access Token from Meta Developer Console → Messenger
META_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx

# ─── Node.js Environment ────────────────────────────────────────────────────

NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Add all variables to cPanel Node.js Manager:
#    - Go to cPanel → Node.js Manager
#    - Select your application
#    - Click "Edit" → Environment Variables
#    - Add each variable above
#
# 2. Or upload this file:
#    - Rename to .env.local
#    - Upload to your application root directory via FTP
#    - Set file permissions to 600
#
# 3. Database Setup:
#    a. PostgreSQL: Create in cPanel Databases
#    b. Redis: Ask hosting provider or use cloud service
#    c. MongoDB: Use MongoDB Atlas (cloud)
#
# 4. Restart Application:
#    - In cPanel Node.js Manager
#    - Stop → Wait 10 seconds → Start
#
# ═══════════════════════════════════════════════════════════════════════════════
